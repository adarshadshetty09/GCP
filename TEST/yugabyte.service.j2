[Unit]
Description=YugabyteDB Cluster (yugabyted-managed)
After=network-online.target
ConditionPathExists={{ yugabyte_install_path }}/{{ yugabyte_dir }}/post_install.sh

[Service]
Type=forking
User={{ yugabyte_user }}
WorkingDirectory={{ yugabyte_install_path }}/{{ yugabyte_dir }}

ExecStart=/usr/bin/python3 {{ yugabyte_install_path }}/{{ yugabyte_dir }}/bin/yugabyted start
ExecStop=/usr/bin/python3 {{ yugabyte_install_path }}/{{ yugabyte_dir }}/bin/yugabyted stop

ExecReload=/bin/kill -HUP $MAINPID

Restart=on-failure
RestartSec=5s

LimitNOFILE=1048576
LimitNPROC=64000
LimitCORE=infinity

StandardOutput=journal
StandardError=journal
SyslogIdentifier=yugabyted

NoNewPrivileges=false
ProtectSystem=default
ProtectHome=no
PrivateTmp=true
ReadWritePaths={{ yugabyte_install_path }}/{{ yugabyte_dir }}

[Install]
WantedBy=multi-user.target
